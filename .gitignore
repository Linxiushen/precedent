# ---------------------------------------------------------------------------
# precedent — repository ignores
# ---------------------------------------------------------------------------

# Per-package uv virtualenvs (created by scripts/dev.sh; never committed)
.venv/
venv/
env/
ENV/
*.egg-info/
build/
dist/
pip-wheel-metadata/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/

# Run artifacts: anything a command in this repo produced rather than a human
results/
out/
outputs/
scratchpad/
*.log

# ...except the acceptor benchmark's task family, which is generated on purpose
# and checked in so it can be run.  One of its tamper cases plants a
# `results/latest.json` inside a skill bundle -- that file IS the test case, and
# the rule above would have silently dropped it from the commit.
!bench/harbor/**

# precedent's own state directory, if someone points --state-dir at the repo.
# Nothing under it belongs in version control: it holds blobs of the user's
# own files, hook logs, spend records and the hash-chained ledger.
.precedent/
*.jsonl.bak
backups/

# Editors / OS
.DS_Store
.AppleDouble
.LSOverride
._*
.idea/
.vscode/
*.swp
*.swo
Thumbs.db

# Node (plugins/openclaw)
node_modules/

# The throwaway venv scripts/dev.sh --zipapp and CI build to prove the zipapp
# needs nothing installed.  uv drops a self-ignoring .gitignore inside it; this
# line is so `git status` does not show the directory itself either.
.venv-bare/
